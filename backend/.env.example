
PROJECT_NAME=BhasaKheti
API_V1_STR=/api/v1
DEBUG=true
ENVIRONMENT=development
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# SQLite Local Database
DATABASE_URL=sqlite:///./bhasakheti.db

# Storage paths for model files
PLANT_DISEASE_MODEL_PATH=../plant_disease_classifier.pth
SOIL_TYPE_MODEL_PATH=../soil_type_classifier.tflite
SOIL_MOISTURE_MODEL_PATH=../soil_moisture_classifier.tflite

# Phase 6: Cohere LLM Configuration (Optional - runs in deterministic verified fallback mode if omitted)
# Get a free trial developer API key at https://dashboard.cohere.com/
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024
LLM_TIMEOUT_SECONDS=25.0
LLM_TEMPERATURE=0.2
